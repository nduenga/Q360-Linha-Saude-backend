# Alternativa a systemd: imagem de produção (gunicorn). O Dockerfile original corre runserver (só dev).
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app

# LibreOffice converte os modelos Word (proposta e apólice) em PDF igual ao Word.
# As fontes do modelo Protteja são a Inter e a Inter Display (licença OFL); o pacote
# fonts-inter da distribuição não traz a Inter Display, por isso vem da versão oficial.
# Sem isto, o PDF usa o layout da plataforma.
ARG INTER_VERSION=4.1
RUN apt-get update \
    && apt-get install -y --no-install-recommends libreoffice-writer-nogui fonts-dejavu-core fontconfig curl unzip ca-certificates \
    && curl -fsSL -o /tmp/inter.zip "https://github.com/rsms/inter/releases/download/v${INTER_VERSION}/Inter-${INTER_VERSION}.zip" \
    && mkdir -p /usr/local/share/fonts/inter \
    && unzip -j -o /tmp/inter.zip 'extras/ttf/*.ttf' -d /usr/local/share/fonts/inter \
    && fc-cache -f \
    && rm -f /tmp/inter.zip \
    && apt-get purge -y curl unzip && apt-get autoremove -y \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.render.txt .
RUN pip install --no-cache-dir -r requirements.render.txt
COPY . .

EXPOSE 8000
# As tabelas são criadas com: docker run --env-file q360.env <imagem> python manage.py migrate
CMD ["gunicorn", "config.wsgi:application", "--bind", "0.0.0.0:8000", "--workers", "2", "--access-logfile", "-"]
