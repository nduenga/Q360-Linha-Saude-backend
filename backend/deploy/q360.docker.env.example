# Copie para /etc/q360-docker.env e preencha no servidor.
# Nunca faça commit do ficheiro preenchido.
# Gerar cada chave com: python3 -c "import secrets; print(secrets.token_urlsafe(48))"

DJANGO_SETTINGS_MODULE=config.settings.production
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=
Q360_JWT_SIGNING_KEY=
CUSTOMER_PORTAL_JWT_SECRET=
DJANGO_ALLOWED_HOSTS=api.seudominio.com
CORS_ALLOWED_ORIGINS=https://app.seudominio.com

# O docker-compose.prod.yml liga a API ao serviço db usando estas credenciais.
# Use uma palavra-passe gerada com secrets.token_urlsafe para evitar caracteres
# que precisem de codificação numa ligação PostgreSQL.
POSTGRES_DB=q360
POSTGRES_USER=q360
POSTGRES_PASSWORD=

EMAIL_HOST=smtp.seudominio.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
CUSTOMER_PORTAL_EMAIL_FROM=
CUSTOMER_PORTAL_URL=https://app.seudominio.com/portal-cliente
