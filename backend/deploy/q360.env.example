# Copie para /etc/q360.env no SERVIDOR e preencha. Nunca faça commit do ficheiro preenchido.
# Gerar cada chave: python -c "import secrets; print(secrets.token_urlsafe(48))"
DJANGO_SETTINGS_MODULE=config.settings.production
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=
Q360_JWT_SIGNING_KEY=
CUSTOMER_PORTAL_JWT_SECRET=
DJANGO_ALLOWED_HOSTS=api.seudominio.com
CORS_ALLOWED_ORIGINS=https://app.seudominio.com
DATABASE_URL=postgres://q360:SENHA_FORTE@localhost:5432/q360
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
CUSTOMER_PORTAL_EMAIL_FROM=
