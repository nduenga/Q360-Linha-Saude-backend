# Copiar para /etc/systemd/system/q360.service
# Ajuste User e os caminhos /opt/q360/backend para o seu servidor.
[Unit]
Description=Q360 Saude API (gunicorn)
After=network.target postgresql.service

[Service]
User=www-data
Group=www-data
WorkingDirectory=/opt/q360/backend
EnvironmentFile=/etc/q360.env
ExecStart=/opt/q360/backend/.venv/bin/gunicorn config.wsgi:application --bind 127.0.0.1:8000 --workers 2 --access-logfile -
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
