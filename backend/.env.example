DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=replace-me
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
POSTGRES_DB=q360
POSTGRES_USER=q360
POSTGRES_PASSWORD=change-me
# Fast local dev (recommended, no Docker): install PostgreSQL natively and
# use POSTGRES_HOST=localhost / POSTGRES_PORT=5432 - see ../DEV_SETUP.md.
# Prefer a disposable container instead? `docker compose up db` maps it to
# host port 5433 (to avoid colliding with a native install): use
# POSTGRES_HOST=localhost / POSTGRES_PORT=5433 for host-side manage.py runs,
# or POSTGRES_HOST=db / POSTGRES_PORT=5432 when running `web` itself inside
# docker-compose (container-to-container, production topology).
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DB_CONN_MAX_AGE=60
# true = point tests at the POSTGRES_* instance above instead of the
# Testcontainers-provisioned disposable Postgres (tests/conftest.py).
Q360_TEST_POSTGRES=false

# --- OAuth2/OIDC Resource Server (Q360-S1-03) ---------------------------
# OPEN DECISION resolved (self-hosted identity, apps.staff_accounts): see backend/OPEN_DECISIONS.md#S01-AUTH-001 — the concrete
# IdP and claim names below are placeholders until the Product Owner/Tech
# Lead confirms them.
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URL=
OIDC_TENANT_CLAIM=tenant_id
OIDC_ROLES_CLAIM=roles
OIDC_ALGORITHMS=HS256
# Dev/test-only escape hatch when no OIDC provider is running locally.
# Never set in production (config/settings/production.py refuses to start).
OIDC_STATIC_VERIFICATION_KEY=

# --- Self-hosted staff identity (apps.staff_accounts) -------------------
# Replaces the OIDC_* external-IdP block above (resolves
# backend/OPEN_DECISIONS.md#S01-AUTH-001). Required in production unless
# you configure a real external IdP instead - production.py enforces
# exactly one of the two. Generate a real value with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
Q360_JWT_SIGNING_KEY=
Q360_STAFF_ACCESS_TOKEN_TTL_SECONDS=1800
Q360_STAFF_REFRESH_TOKEN_TTL_SECONDS=2592000
Q360_STAFF_MAX_FAILED_ATTEMPTS=5
Q360_STAFF_LOCKOUT_MINUTES=30
Q360_STAFF_LOGIN_RATE_LIMIT=10
Q360_STAFF_LOGIN_RATE_WINDOW_SECONDS=60

# --- CORS (frontend integration) ---------------------------------------
# Comma-separated list of browser origins allowed to call this API.
# Empty by default everywhere (nothing allowed). config/settings/development.py
# already defaults this to the Vite dev server (http://localhost:5173) when
# left blank here, so you normally don't need to set it for local dev.
# In production this MUST be set explicitly to the real frontend origin(s).
CORS_ALLOWED_ORIGINS=
