DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=replace-me
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
POSTGRES_DB=q360
POSTGRES_USER=q360
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
# Container-to-container (docker-compose `web` -> `db`) always uses 5432.
# Running manage.py directly on the host instead? Use POSTGRES_HOST=localhost
# and POSTGRES_PORT=5433 (docker-compose.yml maps the db container's 5432 to
# host port 5433 to avoid colliding with a native PostgreSQL install).
POSTGRES_PORT=5432
DB_CONN_MAX_AGE=60
# true = point tests at the POSTGRES_* instance above instead of the
# Testcontainers-provisioned disposable Postgres (tests/conftest.py).
Q360_TEST_POSTGRES=false

# --- OAuth2/OIDC Resource Server (Q360-S1-03) ---------------------------
# OPEN DECISION: see backend/OPEN_DECISIONS.md#S01-AUTH-001 — the concrete
# IdP and claim names below are placeholders until the Product Owner/Tech
# Lead confirms them.
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URL=
OIDC_TENANT_CLAIM=tenant_id
OIDC_ROLES_CLAIM=roles
OIDC_ALGORITHMS=RS256
# Dev/test-only escape hatch when no OIDC provider is running locally.
# Never set in production (config/settings/production.py refuses to start).
OIDC_STATIC_VERIFICATION_KEY=
